# Azure OpenAI configuration (required)
AZURE_OPENAI_ENDPOINT="https://openaidev-westus.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_CHATGPT_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"

# Service principal auth (use this OR the API key below)
AZURE_TENANT_ID="your-tenant-id"
AZURE_CLIENT_ID="your-client-id"
AZURE_CLIENT_SECRET="your-client-secret"

# Or use simple API key
AZURE_OPENAI_API_KEY=""

# GitHub token (for reading/writing private repos)
YOUR_GITHUB_ACCESS_TOKEN="ghp_your_token_here"

# Run port (default: 8002)
PORT=8002
