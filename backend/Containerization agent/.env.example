# ─────────────────────────────────────────────────────────────────────────────
# Docker AI Agent — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHATGPT_DEPLOYMENT=gpt-4o

# Option A: API key auth (simplest)
AZURE_OPENAI_API_KEY=<your-api-key>

# Option B: Service-principal auth (production recommended)
# AZURE_TENANT_ID=<your-tenant-id>
# AZURE_CLIENT_ID=<your-client-id>
# AZURE_CLIENT_SECRET=<your-client-secret>

# ── Container runtime ────────────────────────────────────────────────────────
# Set to 'docker' or 'podman' depending on what is installed on your machine.
CONTAINER_RUNTIME=docker
