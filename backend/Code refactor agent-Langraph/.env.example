# ── Azure OpenAI (Required) ───────────────────────────────────────────────────

# Your Azure OpenAI endpoint URL
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# API version (recommended: 2025-01-01-preview)
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Deployment name (e.g. gpt-4o, gpt-4o-mini)
AZURE_OPENAI_CHATGPT_DEPLOYMENT=gpt-4o

# API Key authentication (use this OR Service Principal below)
AZURE_OPENAI_API_KEY=

# ── Service Principal Authentication (alternative to API key) ─────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Server Configuration ──────────────────────────────────────────────────────

# Port the FastAPI server listens on (default: 18200)
PORT=18200

# Comma-separated browser origins allowed to call the API.
# Do not use "*" with credentialed browser requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8002,http://localhost:18200

# Materialized GitHub repositories are written outside the backend source tree
# so uvicorn --reload does not restart the server and lose in-memory sessions.
REFACTOR_REPOS_DIR=~/.cache/code_refactor_agent/repos

# Disabled by default because this lets the agent run local commands.
ALLOW_TERMINAL_COMMANDS=false
TERMINAL_COMMAND_ALLOWLIST=python,python3,pytest,node,npm,npx,yarn,pnpm,git

# ── NOTE ─────────────────────────────────────────────────────────────────────
# Temporal variables (TEMPORAL_ADDRESS, TEMPORAL_NAMESPACE, TEMPORAL_API_KEY,
# TEMPORAL_TLS) are no longer needed. This agent uses LangGraph with a local
# SQLite checkpoint file (checkpoints.db) instead.
