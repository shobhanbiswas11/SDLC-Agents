# =========================================================
# Azure AD Credentials (for Azure OpenAI authentication)
# =========================================================
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# =========================================================
# Azure OpenAI Service
# =========================================================
AZURE_OPENAI_ENDPOINT=https://openaidev-westus.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHATGPT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# =========================================================
# Resolver tuning (optional — defaults shown)
# =========================================================
DEPRES_DEFAULT_STRATEGY=stable
DEPRES_REGISTRY_TIMEOUT_S=10
DEPRES_OSV_REFRESH_HOURS=6
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500

# =========================================================
# Web search (optional — leave blank to disable)
# =========================================================
SERPAPI_KEY=
BING_SEARCH_KEY=
