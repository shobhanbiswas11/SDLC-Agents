FROM node:22-slim AS builder

WORKDIR /app

# Install dependencies first for better layer caching.
COPY apps/dependency-resolver-agent/package.json ./package.json
COPY apps/dependency-resolver-agent/package-lock.json ./package-lock.json
RUN npm ci

# Copy only the files needed for a production build.
COPY apps/dependency-resolver-agent/index.html ./index.html
COPY apps/dependency-resolver-agent/vite.config.js ./vite.config.js
COPY apps/dependency-resolver-agent/src ./src
COPY apps/dependency-resolver-agent/public ./public

# Vite environment variables must be available at build time.
ARG VITE_API_BASE=http://localhost:8001
ENV VITE_API_BASE=${VITE_API_BASE}

RUN npm run build

FROM node:22-slim

WORKDIR /app
RUN npm install --global serve@14

COPY --from=builder /app/dist ./dist

EXPOSE 5174

CMD ["serve", "-s", "dist", "-l", "5174"]