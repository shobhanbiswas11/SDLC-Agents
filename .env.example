# put this in /backend/dependency-resolver-agent/.env #
# =========================================================
# Azure AD Credentials (for Azure OpenAI authentication)
# =========================================================
AZURE_TENANT_ID = your-azure-tenant-id
AZURE_CLIENT_ID = your-azure-client-id
AZURE_CLIENT_SECRET = your-azure-client-secret
AZURE_OPENAI_ENDPOINT = "https://openaidev-westus.openai.azure.com/"
AZURE_OPENAI_API_VERSION = "2025-01-01-preview"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT = "text-embedding-ada-002"  # e.g., text-embedding-3-large
AZURE_OPENAI_CHATGPT_DEPLOYMENT = "gpt-4o"
