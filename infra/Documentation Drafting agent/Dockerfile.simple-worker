FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY ["backend/Documentation Drafting agent/simple-agent/requirements.txt", "./requirements.txt"]
RUN pip install --no-cache-dir -r requirements.txt

COPY ["backend/Documentation Drafting agent/simple-agent/", "./"]

CMD ["python", "worker.py"]
