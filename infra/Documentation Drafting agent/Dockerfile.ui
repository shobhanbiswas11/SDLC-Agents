FROM node:20-alpine

WORKDIR /app

COPY ["apps/Documentation Drafting agent/package.json", "./package.json"]
COPY ["apps/Documentation Drafting agent/package-lock.json", "./package-lock.json"]
RUN npm ci

COPY ["apps/Documentation Drafting agent/", "./"]

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
